<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WealthOps.Cli</RootNamespace>
    <AssemblyName>wealthops</AssemblyName>
    <UserSecretsId>wealthops-cli</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WealthOps.Application\WealthOps.Application.csproj" />
    <ProjectReference Include="..\WealthOps.Domain\WealthOps.Domain.csproj" />
    <ProjectReference Include="..\WealthOps.Infrastructure\WealthOps.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The template, not the configuration. Real values live in appsettings.Local.json, which is
         gitignored and copied from this file (ADR-003). -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WealthOps.Cli.UnitTest" />
  </ItemGroup>

</Project>
